# .env.example with required variables, typed and commented
NODE_ENV=development
PORT=3001
DB_NAME=civic_platform_dev
DB_USER=user
DB_PASSWORD=supersecretpassword # WARNING: This must be managed securely in a real environment!
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq
# Auth placeholders (Keycloak/Auth0 specific details would go here)
AUTH_URL=http://auth.example.com
JWT_SECRET=supersecurejwtsecret